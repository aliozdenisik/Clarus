# Better Auth Configuration
# Generate a random 32+ character string for BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=your-random-32-char-secret-here-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# Database Connection
# PostgreSQL connection string for Better Auth
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Google OAuth (get from: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sentry Observability (existing - keep as is)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn-here
SENTRY_ORG=sentry
SENTRY_PROJECT=clarus-frontend

# Logging Configuration
# Options: debug, info, warn, error
NEXT_PUBLIC_LOG_LEVEL=info
