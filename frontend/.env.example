# Better Auth Configuration
# REQUIRED: Generate a random 32+ character secret for session signing
# Run: openssl rand -base64 32
# WARNING: Keep this secret, never commit real value to git
BETTER_AUTH_SECRET=

# Better Auth Base URL - Server-side (for auth server config)
BETTER_AUTH_URL=http://localhost:3000

# Better Auth Base URL - Client-side (for browser auth requests)
# IMPORTANT: NEXT_PUBLIC_ prefix makes this available to browser
# Must match your deployment URL in production
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Database Connection
# PostgreSQL connection string for Better Auth
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Google OAuth - Get from Google Cloud Console
# Note: Client ID is public (not secret), safe for frontend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Client Secret (REQUIRED for OAuth to work)
# Get from: https://console.cloud.google.com/apis/credentials
# WARNING: Keep this secret, never commit real value to git
GOOGLE_CLIENT_SECRET=

# Sentry Observability
# DSN - Get from Sentry project settings (public, safe to commit in example)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o12345.ingest.sentry.io/project-id

# Organization slug for source map upload
SENTRY_ORG=your-organization-slug

# Auth Token - Generate at Sentry Settings > Auth Tokens
# REQUIRED SCOPES: project:releases, org:read
# WARNING: DO NOT COMMIT real token, use CI/CD secrets instead
SENTRY_AUTH_TOKEN=sntrys_xxxx

# Logging Configuration
NEXT_PUBLIC_LOG_LEVEL=info

# Backend API URL (change for production deployment)
NEXT_PUBLIC_API_URL=http://localhost:8000


# Polar.sh (billing & subscriptions)
# Get these from https://polar.sh/claruss/settings
# SERVER-SIDE ONLY — do NOT use NEXT_PUBLIC_ prefix for secrets
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRO_PRODUCT_ID=
POLAR_STARTER_PRODUCT_ID=
POLAR_ORG_SLUG=claruss