# Clarus Backend Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to git
#
# Secrets marked with "MUST ROTATE" were exposed in git history
# and should be regenerated with fresh values.

# OpenRouter API Key
# Get your key from: https://openrouter.ai/keys
# MUST ROTATE: This key was exposed in git history (commit af5a297)
OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME

# Web Application Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
# PostgreSQL password for docker-compose (change in production)
POSTGRES_PASSWORD=postgres
JWT_SECRET_KEY=generate-a-strong-random-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_MINUTES=43200

# Google OAuth (get from: https://console.cloud.google.com/apis/credentials)
# MUST ROTATE: These credentials were exposed in git history (commit af5a297)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Rate Limiting
RATE_LIMIT_PER_DAY=50
RATE_LIMIT_ENABLED=false

# CORS Configuration (comma-separated origins, or * for all)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# Query Validation
QUERY_MAX_LENGTH=500
QUERY_MIN_LENGTH=1

# Environment
APP_ENV=development
DEBUG=false

# Sentry Observability
# MUST ROTATE: This DSN was exposed in git history (commit af5a297)
SENTRY_ENABLED=false
SENTRY_DSN_BACKEND=https://your-sentry-dsn-here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=console
# LOG_FILE=/var/log/clarus/backend.log

# Redis Caching
# REDIS_PASSWORD: required in production; optional in local development.
# Without a password, Redis accepts unauthenticated connections from any process
# that can reach port 6379 — exposing cached queries, JWT blacklist, and rate-limit
# counters to anyone on the network.
# Generate a strong password: openssl rand -hex 32
# Set the SAME value in your shell/env before running docker-compose so that
# the Redis container and this backend service both use identical credentials.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0


# Better Auth JWKS (for verifying tokens issued by Next.js frontend)
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
JWT_JWKS_CACHE_TTL=3600

# Admin emails (comma-separated)
ADMIN_EMAILS=

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# i18n
DEFAULT_LOCALE=tr

# Polar.sh (billing & subscriptions)
# Get these from https://polar.sh/claruss/settings
# SERVER-SIDE ONLY — never expose to browser / NEXT_PUBLIC_*
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRO_PRODUCT_ID=
POLAR_ORG_SLUG=claruss