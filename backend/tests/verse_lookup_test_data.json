{
  "metadata": {
    "version": "1.0",
    "total_tests": 56,
    "created_at": "2026-02-05",
    "description": "Comprehensive verse lookup test cases for parser validation. Covers single verses, ranges, multiple verses, invalid formats, and out-of-bounds errors for both Quran and Bible."
  },
  "test_cases": [
    {
      "id": "Q-SINGLE-01",
      "category": "quran_single",
      "input": "Bakara 183",
      "expected": {
        "source": "quran",
        "surah_id": 2,
        "verses": [183]
      },
      "description": "Turkish name single verse"
    },
    {
      "id": "Q-SINGLE-02",
      "category": "quran_single",
      "input": "2:183",
      "expected": {
        "source": "quran",
        "surah_id": 2,
        "verses": [183]
      },
      "description": "Numeric format single verse"
    },
    {
